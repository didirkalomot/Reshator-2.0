from nodes import *
import re

#####################################################################################

class ExpressionParser:
    def __init__(self):
        self.operations = {
            '+': Plus,
            '-': self._create_minus,
            '*': nodes.Mult, 
            '/': nodes.Div,
            '^': nodes.Pow,
            'sin': nodes.Sin,
            'cos': nodes.Cos,
            'ln': nodes.Ln,
            'sqrt': nodes.Sqrt,
        }

    def _create_minus(self, left, right=None):
        return nodes.UnaryMinus(left) if right is None else nodes.BinaryMinus(left, right)

    def parse(self, expression: str) -> nodes.Node:
        expression = expression.replace(' ', '')
        expression = re.sub(r'(\d)([a-zA-Z(])', r'\1*\2', expression)
        expression = re.sub(r'([a-zA-Z)])([a-zA-Z(])', r'\1*\2', expression)
        return self._parse_expression(expression)

    def _parse_expression(self, expression: str, min_priority=0) -> nodes.Node:
        expression = self._remove_brackets(expression)
        
        # Функции
        for name in ['sin', 'cos', 'ln', 'sqrt']:
            if expression.startswith(name + '(') and expression.endswith(')'):
                arg = expression[len(name)+1:-1]
                node = self._parse_expression(arg)
                return self.operations[name](node) if node else None
        
        # Числа и переменные
        try: return nodes.Number(float(expression))
        except: 
            if len(expression) == 1 and expression.isalpha():
                return nodes.Letter(expression)
        
        # Бинарные операторы
        index = self._find_operator(expression, min_priority)
        if index != -1:
            left = self._parse_expression(expression[:index], self._get_priority(expression[index]))
            right = self._parse_expression(expression[index+1:], self._get_priority(expression[index]) + (1 if expression[index] == '^' else 0))
            return self.operations[expression[index]](left, right) if left and right else None
        
        # Унарный минус
        if expression and expression[0] == '-':
            node = self._parse_expression(expression[1:], 2)
            return nodes.UnaryMinus(node) if node else None
        
        return None

    def _get_priority(self, op: str) -> int:
        if op not in self.operations: return 0
        try: return self.operations[op](None).priority
        except: return self.operations[op](None, None).priority

    def _find_operator(self, expression: str, min_priority: int) -> int:
        depth, best_index, best_priority = 0, -1, float('inf')
        
        for i, char in enumerate(reversed(expression)):
            idx = len(expression) - 1 - i
            
            if char == ')': depth += 1
            elif char == '(': depth -= 1
            elif depth == 0 and char in self.operations and char not in ['sin', 'cos', 'ln', 'sqrt']:
                if char == '-' and (idx == 0 or expression[idx-1] in self.operations or expression[idx-1] == '('):
                    continue
                    
                priority = self._get_priority(char)
                if priority >= min_priority and priority <= best_priority:
                    best_priority, best_index = priority, idx
        
        return best_index

    def _remove_brackets(self, expression: str) -> str:
        if len(expression) < 2 or expression[0] != '(' or expression[-1] != ')':
            return expression
            
        depth = 1
        for char in expression[1:-1]:
            if char == '(': depth += 1
            elif char == ')': 
                depth -= 1
                if depth == 0: return expression
        
        return expression[1:-1] if depth == 1 else expression

